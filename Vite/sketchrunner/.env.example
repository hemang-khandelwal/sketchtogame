# Optional overrides. Copy to .env; never commit real credentials.
# CAMERA_PORT=8787
# PUBLIC_URL=https://your-own-tunnel.example
# CLOUDFLARED_PATH=/absolute/path/to/cloudflared

# Optional TURN relay for networks where peer-to-peer video cannot connect.
# Supply credentials from your TURN provider; no relay is bundled.
# TURN_URLS=turn:your-relay.example:3478,turns:your-relay.example:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
